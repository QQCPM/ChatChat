# Supabase Configuration
# Get these values from your Supabase project dashboard:
# https://app.supabase.com/project/_/settings/api

# Your Supabase project URL (format: https://xxxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (starts with eyJhbGci...)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Go to https://app.supabase.com
# 3. Open your project
# 4. Go to Settings > API
# 5. Copy "Project URL" and paste it as VITE_SUPABASE_URL
# 6. Copy "anon public" key and paste it as VITE_SUPABASE_ANON_KEY
# 7. Save the .env file
# 8. Restart your dev server (npm run dev)
